# Copy to server/.env for local development.
# MongoDB Atlas: Database > Connect > Drivers. Put the database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo?retryWrites=true&w=majority
PORT=5000
# Only needed when the API is hosted on a different domain from the client.
# CORS_ORIGIN=https://your-site.netlify.app
